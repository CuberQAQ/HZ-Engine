*start
    # [REAL = true]

    character girl "綾地寧寧"

    show girl normal
    scene bg cafe

    [REAL] "只有在实机才能看到这句话"
    # "神秘人物" "欢迎来到HZEngine的世界!"
    "欢迎来到HZEngine Demo\n(dev-0721a)"

    menu
    @"前往咖啡馆"
        call ciallo
    @"前往eval测试"
        call eval_test
    @"嵌套menu测试"
        menu 
        @"choice1"
            "你选择了choice1"
        @"choice2"
            "你选择了choice2"
        @"choice3"
            menu 
            @"choice3.1"
                "你选择了choice3.1"
            @"choice3.2"
                "你选择了choice3.2"
            @"choice3.3"
                "今天是0721节，你0721了吗"
            end menu
            "菜单结束"
        end menu
        "菜单结束"
        "嵌套测试完成"
    end menu


*end

    # hide girl
    "游戲結束，恭喜達成真結局\n即将触发轮回！！\nQAQ"


    jump start

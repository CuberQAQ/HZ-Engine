*eval_test
    "即将执行单行动态执行代码测试"
    eval console.log("single line eval test")
    "执行单行动态执行代码测试完成"
    "即将执行多行动态执行代码测试"
    script
        console.log("script statement test awa1")
        console.log("script statement test awa2")
        console.log("script statement test awa3")
    end script
    "执行多行动态执行代码测试完成"
    return
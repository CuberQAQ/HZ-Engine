    transition fade = (fadein, fadeout) 

    hide girl
    "即将开始测试"

    "開始named transition測試"
    show girl normal with fade
    girl "Ciallo"

    "開始unnamed transition測試"

    show girl angry with (fadeout,fadein)
    girl "Ciallo2"

    # girl "我将变成萤火虫"
    # show girl normal with fadeout fade_repeat
    # girl "怎么样？"
    girl "byebye"
    hide girl with ([move_to_right_out, fadeout])

    "开始say nowait测试"

    "我爱0721" nowait
    girl "啊？我刚才说了啥？？\n你是不是耳背了？！"

    "开始pause with delay测试"
    girl "这句话会自动在2秒后消失" nowait
    pause 2.0
    girl "成功了！！"  

    "即将开始ScreenShake测试"

    scene bg cafe with (none, screen_shake)
    girl "这里有个屏幕抖动"


{
  "configVersion": "v3",
  "app": {
    "appId": 1103011,
    "appName": "HZEngine Launcher",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "CuberQAQ",
    "description": "HZEngine 0.2.0 Launcher"
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "2.0.0",
      "target": "3.0.0",
      "minVersion": "2.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/transfer",
            "page/project_list",
            "page/project_info",
            "page/settings",
            "page/hz"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        },
        {
          "st": "s"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "HZ-Engine Launcher"
    },
    "zh-CN": {
      "appName": "HZ-Engine 启动器"
    }
  },
  "defaultLanguage": "en-US"
}